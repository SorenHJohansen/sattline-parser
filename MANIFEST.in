# The sdist is the input downstream packagers use, so it must carry the release
# notes, the documentation, and the test suite that proves the code works.
include CHANGELOG.md
include SECURITY.md
include LICENSE
include MANIFEST.in
include pyproject.toml
include uv.lock

recursive-include docs *.md
recursive-include changelog.d *.md
recursive-include tests *.py *.s *.x *.l *.z *.g *.y *.p *.q *.json *.md

# The suite imports these trees, so they travel with it.
recursive-include scripts *.py *.json
recursive-include benchmarks *.py
recursive-include fuzzing *.py

# Build artefacts and local state never belong in an sdist.
prune build
prune dist
prune htmlcov
prune .venv
global-exclude *.py[cod] .DS_Store
